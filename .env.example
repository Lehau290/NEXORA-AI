# ============================================================
# NEXORA AI - Environment Configuration Example
# ============================================================

# Secret key for JWT session encryption
SECRET_KEY=nexora-ai-ultra-secure-jwt-key-2026-x9z2p

# Server configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True

# Database path (SQLite file)
DATABASE_PATH=nexora.db

# AI API Providers (Điền ít nhất 1 API Key để kích hoạt AI trực tiếp)
# Lấy Google Gemini API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (tùy chọn): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude API Key (tùy chọn): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Cấu hình AI mặc định
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash

